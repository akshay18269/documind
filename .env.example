# Copy to .env and edit. Never commit .env.

# ---- Choose ONE LLM provider ----
# Option A (FREE, runs on your laptop, no key): ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2

# Option B (free tier, needs a free key): groq  or  gemini
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your_free_key_here

# Option C (paid): anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=your_key_here

# ---- Retrieval settings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.25
INDEX_DIR=data/index
